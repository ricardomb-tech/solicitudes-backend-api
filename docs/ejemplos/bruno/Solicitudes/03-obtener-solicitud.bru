meta {
  name: Obtener solicitud por id
  type: http
  seq: 3
}

get {
  url: {{base_url}}/solicitudes/{{solicitud_id}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

docs {
  Usa la variable "solicitud_id" capturada por "Crear solicitud". Ejecutar
  esa petición primero, o reemplazar la variable manualmente.
}
