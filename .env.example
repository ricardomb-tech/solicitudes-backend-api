# =============================================================================
# .env.example — plantilla de variables de entorno
# Copiar a ".env" (nunca commitear ".env"; ver .gitignore) y ajustar valores.
# =============================================================================

# --- Aplicación (backend) ---------------------------------------------------
APP_NAME=solicitudes-api
APP_ENV=development
LOG_LEVEL=INFO

# --- PostgreSQL --------------------------------------------------------------
# POSTGRES_HOST=db  -> "db" es el nombre del servicio en docker-compose.yml,
# resuelto por el DNS interno de Docker Compose. NUNCA usar "localhost" aquí:
# dentro de un contenedor, localhost apunta al propio contenedor.
POSTGRES_USER=solicitudes_user
POSTGRES_PASSWORD=changeme_dev_password
POSTGRES_DB=solicitudes_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Cadena de conexión completa que usa SQLAlchemy. Se arma una sola vez aquí
# para no duplicar host/usuario/clave en distintos lugares del código.
DATABASE_URL=postgresql+psycopg://solicitudes_user:changeme_dev_password@db:5432/solicitudes_db

# --- Servicio consumidor ------------------------------------------------------
API_BASE_URL=http://backend:8000
CONSUMER_NUM_REQUESTS=10
CONSUMER_TIMEOUT_CONNECT_S=3
CONSUMER_TIMEOUT_READ_S=10
CONSUMER_MAX_RETRIES=3
CONSUMER_BACKOFF_BASE_S=0.5
